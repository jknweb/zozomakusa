{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"slug": "section-feuille",
	"title": "Section feuille",
	"blockTypes": [ "core/group", "core/columns", "core/column" ],
	"styles": {
		"color": {
			"background": "var:preset|color|feuille",
			"text": "var:preset|color|nappe"
		},
		"elements": {
			"heading": { "color": { "text": "var:preset|color|nappe" } },
			"link": { "color": { "text": "var:preset|color|nappe" } },
			"button": {
				"color": { "background": "var:preset|color|nappe", "text": "var:preset|color|feuille" },
				":hover": { "color": { "background": "var:preset|color|laiton", "text": "var:preset|color|nuit" } }
			}
		}
	}
}
